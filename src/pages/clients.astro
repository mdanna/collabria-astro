---
import Base from '../layouts/Base.astro';
import clientsData from '../data/clients.json';
const clients = clientsData.clients.map(c => ({
  ...c,
  logo: c.logo.startsWith('/') ? c.logo : '/' + c.logo,
}));
---
<Base title="Clients" activePage="clients">
<style>
  .clients-section { background: var(--cream); padding: 80px 2rem 100px; min-height: calc(100vh - 72px); }
  .clients-intro { text-align: center; margin-bottom: 3rem; }
  .clients-intro-label { font-size: 0.85rem; font-weight: 300; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brown-mid); display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1rem; }
  .clients-intro-label::before, .clients-intro-label::after { content: ''; width: 24px; height: 1px; background: var(--brown-mid); }
  .clients-intro h1 { font-size: clamp(1.6rem, 2.5vw, 2rem); font-weight: 100; color: var(--espresso); letter-spacing: 0.06em; }
  .hex-grid-wrap { margin: 0 auto; width: fit-content; max-width: 100%; }
  /* hex-row styles are applied via JS to avoid Astro scoping stripping them from dynamic elements */
  .hex { width: 130px; height: 150px; clip-path: polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%); background: var(--white); display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 20px; flex-shrink: 0; transition: background 0.2s, filter 0.2s; filter: drop-shadow(0 0 4px var(--beige-mid)); }
  .hex:hover { background: var(--beige); }
  .hex-logo { max-width: 100%; max-height: 106px; width: auto; height: auto; object-fit: contain; mix-blend-mode: multiply; }
  .hex-name { font-family: 'Josefin Sans', sans-serif; font-weight: 300; font-size: 0.72rem; color: var(--espresso); letter-spacing: 0.06em; line-height: 1.35; }
  @media (max-width: 420px) { .hex { width: 90px; height: 104px; } .hex-logo { max-height: 70px; } }
</style>

<section class="clients-section" style="padding-top:80px">
  <div class="clients-intro">
    <div class="clients-intro-label">Our Clients</div>
    <h1>Organizations we've had the privilege to serve</h1>
  </div>
  <div class="hex-grid-wrap" id="hexGrid">
    {clients.map(c => (
      <div class="hex" data-hex>
        <img class="hex-logo" src={c.logo} alt={c.name}
          onerror={`this.outerHTML='<span class="hex-name">${c.name}</span>'`} />
      </div>
    ))}
  </div>
</section>

<script>
  (function () {
    const W = 130, H = 150, GAP = 3;
    const grid = document.getElementById('hexGrid')!;
    let resizeTimer: ReturnType<typeof setTimeout>;
    function hexWidth() { const s = grid.querySelector('.hex') as HTMLElement; return (s ? s.offsetWidth : 0) || W; }
    function buildGrid() {
      const hexes = Array.from(grid.querySelectorAll<HTMLElement>('[data-hex]'));
      const w = hexWidth();
      const gap = GAP;
      const available = (grid.parentElement?.clientWidth ?? 800) - 32;
      const perRow = Math.max(2, Math.floor((available + gap) / (w + gap)));
      grid.style.width = (perRow * (w + gap) - gap) + 'px';
      grid.innerHTML = '';
      let i = 0, rowIdx = 0;
      while (i < hexes.length) {
        const isOffset = rowIdx % 2 === 1;
        const count = isOffset ? Math.max(1, perRow - 1) : perRow;
        const row = document.createElement('div');
        row.className = 'hex-row' + (isOffset ? ' offset' : '');
        row.style.display = 'flex';
        row.style.gap = '3px';
        const overlap = Math.round(w * 1.1547 * 0.25);
        const halfStep = Math.round((w + gap) / 2);
        row.style.marginTop = rowIdx === 0 ? '0' : `-${overlap}px`;
        if (isOffset) row.style.paddingLeft = `${halfStep}px`;
        for (let j = 0; j < count && i < hexes.length; j++) row.appendChild(hexes[i++]);
        grid.appendChild(row);
        rowIdx++;
      }
    }
    // Run after all stylesheets are loaded so offsetWidth is correct
    window.addEventListener('load', () => {
      buildGrid();
      window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(buildGrid, 80); });
    });
  })();
</script>
</Base>
