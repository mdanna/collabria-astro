---
export const prerender = true;
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Collabria CMS</title>
  <style>
    body { margin: 0; }
    #cms-guide-link {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      background: #3b1a0c;
      color: #fdf8f3;
      text-decoration: none;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      font-size: 0.75rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      padding: 0.6rem 1.1rem;
      border-radius: 3px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 2px 12px rgba(0,0,0,0.18);
      transition: background 0.2s;
    }
    #cms-guide-link:hover { background: #5c2d12; }
    #cms-guide-link svg { width: 14px; height: 14px; flex-shrink: 0; }
  </style>
</head>
<body>
<script is:inline>
window.CMS_MANUAL_INIT = true;
</script>
<script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
<script is:inline>
CMS.init({
  config: {
    backend: {
      name: 'github',
      repo: 'mdanna/collabria-astro',
      branch: 'main',
      base_url: 'https://collabria-astro.vercel.app',
      auth_endpoint: 'api/auth',
    },
    media_folder: 'public/logos',
    public_folder: '/logos',
    collections: [
      {
        name: 'cases',
        label: 'Case Studies',
        label_singular: 'Case Study',
        folder: 'src/content/cases',
        create: true,
        delete: true,
        identifier_field: 'client',
        summary: '{{client}} — {{title}}',
        slug: '{{fields.client}}',
        extension: 'md',
        format: 'frontmatter',
        fields: [
          { label: 'Client Name', name: 'client', widget: 'string' },
          { label: 'Title', name: 'title', widget: 'string' },
          { label: 'Logo', name: 'logo', widget: 'image', hint: 'Upload a new logo or keep the existing path' },
          { label: 'Challenge Quote', name: 'challenge', widget: 'text' },
          {
            label: 'Tags',
            name: 'tags',
            widget: 'list',
            required: false,
            field: { label: 'Tag', name: 'tag', widget: 'string' },
          },
          { label: 'Solution', name: 'body', widget: 'markdown' },
        ],
      },
      {
        name: 'site_data',
        label: 'Site Data',
        files: [
          {
            label: 'Client List',
            name: 'clients',
            file: 'src/data/clients.json',
            preview_path: 'clients',
            fields: [
              {
                label: 'Clients',
                name: 'clients',
                widget: 'list',
                fields: [
                  { label: 'Company Name', name: 'name', widget: 'string' },
                  { label: 'Logo Path', name: 'logo', widget: 'string', hint: 'Must start with /  e.g. /logos/cisco.jpg  — or use the Media tab to upload and copy the path' },
                ],
              },
            ],
          },
          {
            label: 'Homepage Quotes',
            name: 'hero_quotes',
            file: 'src/data/hero-quotes.json',
            preview_path: '/',
            fields: [
              {
                label: 'Quotes',
                name: 'quotes',
                widget: 'list',
                fields: [
                  { label: 'Quote', name: 'quote', widget: 'text' },
                  { label: 'Client Name', name: 'client', widget: 'string' },
                  { label: 'Case Slug', name: 'slug', widget: 'string', hint: 'e.g. irhythm' },
                ],
              },
            ],
          },
          {
            label: 'Services',
            name: 'services',
            file: 'src/data/services.json',
            preview_path: '/',
            fields: [
              {
                label: 'Services',
                name: 'services',
                widget: 'list',
                fields: [
                  { label: 'Title', name: 'title', widget: 'string' },
                  { label: 'Lead Sentence', name: 'lead', widget: 'text', required: false, hint: 'Bold intro line shown above the body text' },
                  { label: 'Pull Quote', name: 'quote', widget: 'text', required: false, hint: 'Italic quote (used instead of lead on Culture & Change)' },
                  { label: 'Body', name: 'body', widget: 'text' },
                  { label: 'Bullet Points', name: 'items', widget: 'text', hint: 'One bullet per line' },
                ],
              },
            ],
          },
        ],
      },
    ],
  },
});
</script>
</body>
<script is:inline>
// Map each CMS file/collection to its live URL
var PREVIEW_URLS = {
  clients:     'https://collabria-astro.vercel.app/clients',
  hero_quotes: 'https://collabria-astro.vercel.app/',
  services:    'https://collabria-astro.vercel.app/#services',
  cases:       'https://collabria-astro.vercel.app/cases',
};

function getLiveUrl() {
  var hash = window.location.hash || '';
  // Case study entry: #/collections/cases/entries/irhythm
  var entryMatch = hash.match(/\/collections\/cases\/entries\/([^/]+)/);
  if (entryMatch) return 'https://collabria-astro.vercel.app/stories/' + entryMatch[1];
  // Site data file: #/collections/site_data/entries/clients
  var fileMatch = hash.match(/\/entries\/([^/]+)$/);
  if (fileMatch && PREVIEW_URLS[fileMatch[1]]) return PREVIEW_URLS[fileMatch[1]];
  // Collection index
  var colMatch = hash.match(/\/collections\/([^/]+)$/);
  if (colMatch && PREVIEW_URLS[colMatch[1]]) return PREVIEW_URLS[colMatch[1]];
  return 'https://collabria-astro.vercel.app/';
}

function patchPreviewButtons() {
  document.querySelectorAll('a, button').forEach(function (el) {
    if (el.dataset.patched) return;
    var text = el.textContent || '';
    if (text.includes('Check for Preview') || text.includes('View Preview')) {
      el.dataset.patched = 'true';
      // Replace entire element with a clean anchor
      var a = document.createElement('a');
      a.href = getLiveUrl();
      a.target = '_blank';
      a.rel = 'noopener';
      a.style.cssText = el.getAttribute('style') || '';
      a.className = el.className;
      a.textContent = 'View on Site ↗';
      a.style.cursor = 'pointer';
      el.parentNode && el.parentNode.replaceChild(a, el);
    }
  });
}

// Re-run whenever Decap re-renders (hash changes or DOM mutations)
var observer = new MutationObserver(patchPreviewButtons);
observer.observe(document.body, { childList: true, subtree: true });
window.addEventListener('hashchange', patchPreviewButtons);
</script>

<a id="cms-guide-link" href="/collabria-cms-guide.docx" download="Collabria CMS User Guide.docx">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
    <polyline points="7 10 12 15 17 10"/>
    <line x1="12" y1="15" x2="12" y2="3"/>
  </svg>
  User Guide
</a>
</html>
