---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" activePage="contact">
<style>
  .contact-hero { min-height: 42vh; background: linear-gradient(135deg, #2c1506 0%, #5c2d12 50%, #3b1a0c 100%); display: flex; align-items: center; justify-content: center; text-align: center; padding: 4rem 3rem; position: relative; overflow: hidden; }
  .contact-hero::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(-45deg, transparent, transparent 40px, rgba(255,255,255,0.015) 40px, rgba(255,255,255,0.015) 41px); }
  .contact-hero-inner { position: relative; z-index: 1; }
  .contact-hero h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 100; color: var(--cream); letter-spacing: 0.08em; line-height: 1.2; }
  .contact-hero h1 strong { font-weight: 300; }
  .contact-section { padding: 80px 3rem 120px; background: var(--white); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; max-width: 900px; }
  .contact-name { font-size: 1.5rem; font-weight: 100; color: var(--espresso); letter-spacing: 0.08em; margin-bottom: 0.25rem; }
  .contact-role { font-size: 0.8rem; font-weight: 300; color: var(--text-soft); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 2.5rem; }
  .contact-items { display: flex; flex-direction: column; }
  .contact-item { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 0; border-bottom: 1px solid var(--beige-mid); }
  .contact-item:first-child { border-top: 1px solid var(--beige-mid); }
  .contact-item-label { font-size: 0.72rem; font-weight: 300; letter-spacing: 0.15em; text-transform: uppercase; color: var(--taupe); }
  .contact-item-value { font-size: 0.88rem; font-weight: 300; color: var(--brown-mid); letter-spacing: 0.04em; text-decoration: none; transition: color 0.2s; }
  .contact-item-value:hover { color: var(--espresso); }
  .contact-message { padding-top: 0.5rem; }
  .contact-message-rule { width: 30px; height: 1.5px; background: var(--taupe); margin-bottom: 2rem; }
  .contact-message h2 { font-size: 1.2rem; font-weight: 100; color: var(--espresso); letter-spacing: 0.06em; line-height: 1.4; margin-bottom: 1rem; }
  .contact-message p { font-size: 0.88rem; color: var(--text-soft); line-height: 1.85; margin-bottom: 2rem; }
  @media (max-width: 768px) { .contact-section { padding: 60px 1.5rem 80px; } .contact-grid { grid-template-columns: 1fr; gap: 3rem; } }
</style>

<div class="contact-hero">
  <div class="contact-hero-inner">
    <h1>Connect with <strong>Lisa</strong></h1>
  </div>
</div>

<section class="contact-section">
  <div class="section-inner">
    <div class="contact-grid">
      <div>
        <p class="contact-name">Lisa Mroz</p>
        <p class="contact-role">Managing Partner, Collabria</p>
        <div class="contact-items">
          {[
            { label: 'Email',    href: 'mailto:lisa@collabriainc.com', text: 'lisa@collabriainc.com' },
            { label: 'Phone',    href: 'tel:+14158064025',             text: '+1 415 806 4025' },
            { label: 'LinkedIn', href: 'https://www.linkedin.com/in/lisamroz', text: 'Lisa Mroz', external: true },
            { label: 'WhatsApp', href: 'https://wa.me/14158064025',    text: '+1 415 806 4025', external: true },
          ].map(item => (
            <div class="contact-item">
              <span class="contact-item-label">{item.label}</span>
              <a href={item.href} class="contact-item-value" {...(item.external ? { target:'_blank', rel:'noopener' } : {})}>{item.text}</a>
            </div>
          ))}
        </div>
      </div>
      <div class="contact-message">
        <div class="contact-message-rule"></div>
        <h2>Let's start a conversation</h2>
        <p>Whether you're facing a leadership challenge, navigating organizational transformation, or working through a cultural shift — Collabria is ready to partner with you on what matters most.</p>
        <a href="mailto:lisa@collabriainc.com" class="btn-primary">Send a Message</a>
      </div>
    </div>
  </div>
</section>
</Base>
