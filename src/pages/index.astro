---
import Base from '../layouts/Base.astro';
import servicesData from '../data/services.json';
const services = servicesData.services;
import heroQuotesData from '../data/hero-quotes.json';
const heroQuotes = heroQuotesData.quotes;
import { featuredCase, casesPreview } from '../data/cases-preview.js';
---
<Base title="collabria" activePage="overview">
<style>
  /* ── SPLIT HERO ── */
  .hero { display: grid; grid-template-columns: 55fr 45fr; min-height: 100vh; }

  .hero-left {
    background: var(--cream);
    display: flex; flex-direction: column; justify-content: center;
    padding: 6rem 4rem; border-right: 1px solid var(--beige-mid);
  }

  .hero-eyebrow {
    display: flex; align-items: center; gap: 0.75rem;
    font-size: 0.85rem; font-weight: 300; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--brown-mid); margin-bottom: 2.5rem;
  }
  .hero-eyebrow::before { content: ''; display: block; width: 24px; height: 1px; background: var(--brown-mid); flex-shrink: 0; }

  .hero-title { font-size: clamp(3rem, 5.5vw, 5.2rem); font-weight: 100; color: var(--espresso); letter-spacing: 0.04em; line-height: 1.1; margin-bottom: 2rem; }
  .hero-title em { font-style: italic; font-weight: 300; font-family: 'Cormorant Garamond', Georgia, serif; letter-spacing: 0.02em; }

  .hero-sub { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem; font-weight: 300; color: var(--text-soft); line-height: 1.75; max-width: 460px; margin-bottom: 3rem; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .hero-stat-row { margin-top: auto; padding-top: 3rem; display: flex; gap: 3rem; }
  .hero-stat strong { display: block; font-size: 2rem; font-weight: 100; color: var(--espresso); letter-spacing: 0.04em; }
  .hero-stat span { font-size: 0.7rem; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brown-mid); }

  .hero-right {
    background: var(--clients-bg);
    display: flex; align-items: center; justify-content: center;
    padding: 5rem 3.5rem; position: relative; overflow: hidden;
  }
  .hero-right::before {
    content: '\201C'; position: absolute; top: -1rem; left: 2rem;
    font-family: 'Cormorant Garamond', Georgia, serif; font-size: 14rem;
    color: rgba(253,248,243,0.06); line-height: 1; pointer-events: none;
  }

  .hero-quotes { width: 100%; position: relative; }
  .hero-quote { opacity: 0; position: absolute; top: 0; left: 0; right: 0; transition: opacity 0.9s ease; pointer-events: none; }
  .hero-quote.active { opacity: 1; position: relative; pointer-events: auto; }

  .hero-quote-text { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.15rem, 1.8vw, 1.45rem); font-weight: 300; font-style: italic; color: var(--cream); line-height: 1.65; margin-bottom: 2rem; }
  .hero-quote-attr { display: block; font-size: 0.7rem; font-weight: 300; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(253,248,243,0.5); margin-bottom: 1.5rem; }
  .hero-quote-link { font-size: 0.72rem; font-weight: 300; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(253,248,243,0.65); text-decoration: none; border-bottom: 1px solid rgba(253,248,243,0.25); padding-bottom: 2px; transition: color 0.2s, border-color 0.2s; }
  .hero-quote-link:hover { color: var(--cream); border-color: rgba(253,248,243,0.65); }

  .hero-quote-dots { display: flex; gap: 0.5rem; margin-top: 2.5rem; }
  .hero-quote-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(253,248,243,0.25); border: none; cursor: pointer; padding: 0; transition: background 0.2s; }
  .hero-quote-dot.active { background: rgba(253,248,243,0.8); }

  /* ── APPROACH ── */
  .approach { background: var(--beige); padding: 100px 3rem; }
  .approach-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; margin-top: 4rem; }
  .value-list { display: flex; flex-direction: column; }
  .value-item { display: flex; gap: 1.5rem; padding: 1.75rem 0; border-bottom: 1px solid var(--beige-mid); }
  .value-item:first-child { padding-top: 0; }
  .value-item:last-child { border-bottom: none; }
  .value-num { font-size: 0.68rem; font-weight: 300; letter-spacing: 0.08em; color: var(--taupe); padding-top: 0.15rem; min-width: 22px; }
  .value-content strong { display: block; font-size: 0.9rem; font-weight: 400; color: var(--espresso); letter-spacing: 0.08em; margin-bottom: 0.4rem; }
  .value-content p { font-size: 0.88rem; color: var(--text-soft); line-height: 1.75; }

  /* ── SERVICES ── */
  .services { padding: 100px 3rem; background: var(--white); }
  .services-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-bottom: 4rem; }
  .services-header .section-body { max-width: 360px; font-size: 0.9rem; }
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; background: var(--beige-mid); border: 1.5px solid var(--beige-mid); border-radius: 4px; overflow: hidden; }
  .service-card { background: var(--white); padding: 2.75rem 2.25rem; display: flex; flex-direction: column; transition: background 0.25s; }
  .service-card:hover { background: var(--cream); }
  .service-rule { width: 30px; height: 1.5px; background: var(--taupe); margin-bottom: 2rem; }
  .service-title { font-size: 1.05rem; font-weight: 400; color: var(--espresso); letter-spacing: 0.08em; margin-bottom: 1rem; }
  .service-quote { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; color: var(--brown-warm); font-size: 1rem; margin-bottom: 1rem; line-height: 1.6; }
  .service-lead { font-size: 0.88rem; font-weight: 400; color: var(--brown-dark); margin-bottom: 0.85rem; line-height: 1.6; }
  .service-body { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1rem; color: var(--text-soft); line-height: 1.75; margin-bottom: 2rem; flex: 1; }
  .service-list { list-style: none; border-top: 1px solid var(--beige-mid); padding-top: 1.5rem; display: flex; flex-direction: column; gap: 0.65rem; }
  .service-list li { font-size: 0.82rem; color: var(--brown-mid); font-weight: 300; display: flex; align-items: flex-start; gap: 0.75rem; letter-spacing: 0.04em; line-height: 1.4; }
  .service-list li::before { content: ''; width: 14px; height: 1px; background: var(--taupe); flex-shrink: 0; margin-top: 0.58rem; }

  /* ── FEATURED CASE ── */
  .featured-case { background: var(--beige); padding: 100px 3rem; border-top: 1px solid var(--beige-mid); }
  .featured-case-grid { display: grid; grid-template-columns: 1fr 420px; gap: 5rem; align-items: center; }
  .featured-case-card { background: var(--white); border: 1px solid var(--beige-mid); border-radius: 4px; overflow: hidden; }
  .featured-case-logo-wrap { height: 200px; display: flex; align-items: center; justify-content: center; padding: 2.5rem; border-bottom: 1px solid var(--beige-mid); }
  .featured-case-logo-wrap img { max-width: 80%; max-height: 110px; width: auto; height: auto; object-fit: contain; mix-blend-mode: multiply; }
  .featured-case-tags { padding: 1.25rem 2rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .featured-case-tags span { font-size: 0.68rem; font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brown-mid); padding: 0.3rem 0.7rem; border: 1px solid var(--beige-mid); border-radius: 2px; }
  .featured-case-footer { background: var(--espresso); padding: 1.75rem 2rem; }
  .featured-case-client { font-size: 0.78rem; font-weight: 400; color: var(--cream); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.4rem; }
  .featured-case-challenge { font-size: 0.85rem; font-weight: 300; color: rgba(253,248,243,0.65); line-height: 1.5; }

  /* ── CLIENTS PREVIEW ── */
  .clients-preview { background: var(--clients-bg); padding: 80px 3rem; text-align: center; }
  .clients-preview-label { font-size: 0.85rem; font-weight: 300; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(253,248,243,0.85); display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1rem; }
  .clients-preview-label::before, .clients-preview-label::after { content: ''; width: 24px; height: 1px; background: rgba(253,248,243,0.6); display: block; }
  .clients-preview-title { font-size: clamp(1.6rem, 2.5vw, 2rem); font-weight: 100; color: var(--cream); letter-spacing: 0.06em; margin-bottom: 2.5rem; }
  .clients-ticker { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.25rem; max-width: 900px; margin: 0 auto 3rem; }
  .clients-ticker span { font-size: 0.8rem; font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(253,248,243,0.65); padding: 0.35rem 0.85rem; border: 1px solid rgba(253,248,243,0.18); border-radius: 2px; }

  /* ── CTA ── */
  .cta-section { background: var(--espresso); padding: 110px 3rem; }
  .cta-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .cta-label { font-size: 0.85rem; font-weight: 300; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brown-warm); display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.5rem; }
  .cta-label::before, .cta-label::after { content: ''; width: 24px; height: 1px; background: var(--brown-warm); }
  .cta-title { font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 100; color: var(--cream); line-height: 1.2; letter-spacing: 0.06em; margin-bottom: 1.5rem; }
  .cta-title strong { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 300; font-size: 1.15em; }
  .cta-body { font-size: 0.95rem; color: rgba(253,248,243,0.55); line-height: 1.85; margin-bottom: 2.75rem; }

  /* ── RESPONSIVE ── */
  @media (max-width: 1100px) { .featured-case-grid { grid-template-columns: 1fr; gap: 3rem; } .featured-case-card { max-width: 480px; } }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-left { padding: 4rem 2rem 3rem; min-height: 60vh; }
    .hero-right { min-height: 45vh; padding: 3rem 2rem; }
    .hero-stat-row { margin-top: 3rem; gap: 2rem; }
    .approach { padding: 70px 1.5rem; }
    .approach-grid { grid-template-columns: 1fr; gap: 3rem; }
    .services { padding: 70px 1.5rem; }
    .services-header { flex-direction: column; align-items: flex-start; }
    .services-grid { grid-template-columns: 1fr; }
    .featured-case { padding: 70px 1.5rem; }
    .clients-preview { padding: 60px 1.5rem; }
    .cta-section { padding: 80px 1.5rem; }
  }
</style>

<!-- SPLIT HERO -->
<section class="hero">
  <div class="hero-left">
    <span class="hero-eyebrow">Organizational Consulting</span>
    <h1 class="hero-title">Navigate<br /><em>Growth.</em></h1>
    <p class="hero-sub">We partner with leaders to turn complexity into clarity — and strategy into sustained, measurable action.</p>
    <div class="hero-actions">
      <a href="/cases" class="btn-primary">View Our Cases</a>
      <a href="/about" class="btn-outline">Get in Touch</a>
    </div>
    <div class="hero-stat-row">
      <div class="hero-stat"><strong>35+</strong><span>Years of experience</span></div>
      <div class="hero-stat"><strong>60+</strong><span>Organizations served</span></div>
      <div class="hero-stat"><strong>95%</strong><span>Retention rate</span></div>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-quotes">
      {heroQuotes.map((q, i) => (
        <div class={`hero-quote${i === 0 ? ' active' : ''}`}>
          <p class="hero-quote-text">&ldquo;{q.quote}&rdquo;</p>
          <span class="hero-quote-attr">— {q.client}</span>
          <a href={`/stories/${q.slug}`} class="hero-quote-link">Read the story</a>
        </div>
      ))}
      <div class="hero-quote-dots">
        {heroQuotes.map((_, i) => (
          <button class={`hero-quote-dot${i === 0 ? ' active' : ''}`} data-index={i}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const quotes = document.querySelectorAll('.hero-quote:not(.hero-quote-dots)');
  const dots = document.querySelectorAll('.hero-quote-dot');
  let current = 0;
  let interval: ReturnType<typeof setInterval>;
  function goTo(n: number) {
    quotes[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = (n + quotes.length) % quotes.length;
    quotes[current].classList.add('active');
    dots[current].classList.add('active');
  }
  function start() { interval = setInterval(() => goTo(current + 1), 5500); }
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      clearInterval(interval);
      goTo(parseInt((dot as HTMLElement).dataset.index!));
      start();
    });
  });
  start();
</script>

<!-- APPROACH -->
<section class="approach">
  <div class="section-inner">
    <span class="section-label">Our Approach</span>
    <h2 class="section-title">Structured thinking.<br /><strong>Flexible execution.</strong></h2>
    <div class="approach-grid">
      <div>
        <p class="section-body serif" style="font-size:1.1rem;line-height:1.85">We believe that lasting organizational change requires both a clear framework and the agility to adapt. Collabria works alongside your leadership to turn complexity into clarity — and strategy into action.</p>
        <br />
        <p class="section-body serif" style="font-size:1.1rem;line-height:1.85">Whether you're navigating a merger, accelerating growth, or realigning your team, we bring the expertise and partnership needed to move forward with confidence.</p>
      </div>
      <div class="value-list">
        {[
          { num: '01', title: 'Creativity & Flexibility', body: "Partnership and solution tailored to your organization's unique context and stage of growth." },
          { num: '02', title: 'Action & Execution', body: 'A drive toward measurable outcomes — not just strategy, but disciplined follow-through.' },
          { num: '03', title: 'Integrity & Results', body: 'An unwavering commitment to honesty and outcomes that can be clearly measured and reported.' },
        ].map(v => (
          <div class="value-item">
            <span class="value-num">{v.num}</span>
            <div class="value-content">
              <strong>{v.title}</strong>
              <p>{v.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="services">
  <div class="section-inner">
    <div class="services-header">
      <div>
        <span class="section-label">What We Do</span>
        <h2 class="section-title">Three practice areas.<br /><strong>One integrated approach.</strong></h2>
      </div>
      <p class="section-body">Three interconnected disciplines addressing the most critical levers of organizational performance.</p>
    </div>
    <div class="services-grid">
      {services.map(s => (
        <div class="service-card">
          <div class="service-rule"></div>
          <h3 class="service-title">{s.title}</h3>
          {s.quote && <p class="service-quote">{s.quote}</p>}
          {s.lead && <p class="service-lead">{s.lead}</p>}
          <p class="service-body">{s.body}</p>
          <ul class="service-list">
            {(typeof s.items === 'string' ? s.items.split('\n') : s.items).map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FEATURED CASE -->
<section class="featured-case">
  <div class="section-inner">
    <div class="featured-case-grid">
      <div>
        <span class="section-label">Featured Work</span>
        <h2 class="section-title">Scaling an HR organization<br /><strong>for IPO readiness.</strong></h2>
        <p class="section-body serif" style="font-size:1.05rem;line-height:1.85;margin-bottom:2rem">{featuredCase.description}</p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap">
          <a href={`/stories/${featuredCase.slug}`} class="btn-slate">Read the Case</a>
          <a href="/cases" class="btn-outline">All Cases</a>
        </div>
      </div>
      <div class="featured-case-card">
        <div class="featured-case-logo-wrap">
          <img src={featuredCase.logo} alt={featuredCase.client} />
        </div>
        <div class="featured-case-tags">
          {featuredCase.tags.map(tag => <span>{tag}</span>)}
        </div>
        <div class="featured-case-footer">
          <p class="featured-case-client">{featuredCase.client}</p>
          <p class="featured-case-challenge">{featuredCase.title}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CLIENTS PREVIEW -->
<section class="clients-preview">
  <div class="clients-preview-label">Trusted by</div>
  <h2 class="clients-preview-title">Organizations that lead their industries</h2>
  <div class="clients-ticker">
    {['Chevron','Visa','HP','Cisco','NASA','Mozilla','Genentech','Accenture','Digital Realty','IDEO','Riot Games','Dolby',"Levi's",'ExxonMobil','Stanford University','Diageo'].map(n => <span>{n}</span>)}
  </div>
  <a href="/clients" class="btn-light">View All Clients</a>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="cta-inner">
    <div class="cta-label">Let's Talk</div>
    <h2 class="cta-title">Ready to navigate<br /><strong>your next phase of growth?</strong></h2>
    <p class="cta-body">Whether you're facing a leadership challenge, organizational transformation, or a cultural shift — Collabria is ready to partner with you.</p>
    <a href="/about" class="btn-light">Get in Touch</a>
  </div>
</section>
</Base>
